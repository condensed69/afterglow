#!/bin/sh
# pre-push — refuse to push a branch that is not rooted on the current origin/main.
#
# Why this exists: on 2026-08-12 a branch was cut from another feature branch
# instead of from main. That branch was then squash-merged, so the carried
# commits became content-duplicates with different SHAs, the PR went
# mergeable_state=dirty, and GitHub built NO check runs at all — it needs a
# synthetic merge ref to check out a pull_request-triggered workflow, and
# can't build one for an unmergeable PR. No gates, no review. The work looked
# done and nothing had verified it.
#
# AGENTS.md already carried the prose rule ("rebase onto the latest main before
# opening a PR"). Prose did not hold. This does.
#
# Not active until you opt in once per clone: git config core.hooksPath .githooks
#
# Bypass (deliberate, logged in the output): HERMES_ALLOW_STALE_BASE=1 git push …
set -u

MAIN=main
Z=0000000000000000000000000000000000000000
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"

if [ "${HERMES_ALLOW_STALE_BASE:-}" = "1" ]; then
  echo "pre-push: base check BYPASSED via HERMES_ALLOW_STALE_BASE=1" >&2
  exit 0
fi

# Explicit refspec, not `git fetch origin main`: this repo's
# remote.origin.fetch has previously accumulated narrow per-branch refspecs
# (see docs/runbooks/hermes-github-push.md in the homelab repo) and the
# config-driven form has been observed to hang indefinitely. An explicit
# refspec is immune to that.
REFSPEC="+refs/heads/$MAIN:refs/remotes/origin/$MAIN"
if ! timeout 45 git fetch -q --no-tags origin "$REFSPEC" 2>/dev/null; then
  # Some hosts (e.g. github.com:22 from a container) time out intermittently.
  # This repo is public, so an anonymous HTTPS fetch is a valid second opinion
  # on where main is.
  if ! timeout 45 git fetch -q --no-tags \
      "https://github.com/condensed69/stripper-dance.git" "$REFSPEC" 2>/dev/null; then
    echo "pre-push: could not reach origin/$MAIN over ssh or https; allowing push UNCHECKED." >&2
    exit 0
  fi
fi

rc=0
while read -r localref localsha remoteref remotesha; do
  # branch deletion, or nothing to push
  case "$localsha" in "$Z"|"") continue ;; esac
  # pushing main itself is not what this guard is about
  case "$remoteref" in "refs/heads/$MAIN") continue ;; esac

  if git merge-base --is-ancestor "origin/$MAIN" "$localsha" 2>/dev/null; then
    continue
  fi

  rc=1
  branch="${localref#refs/heads/}"
  [ -n "$branch" ] || branch="$(git rev-parse --abbrev-ref HEAD)"

  echo "" >&2
  echo "=========================================================================" >&2
  echo " PUSH REFUSED: '$branch' is not on top of the current origin/$MAIN." >&2
  echo "=========================================================================" >&2
  echo "" >&2
  echo " A PR from this branch would conflict, and GitHub creates NO check runs" >&2
  echo " for a conflicted PR — no gates, no review. Fix the base first." >&2
  echo "" >&2

  main_subjects="$(git log --format=%s -n 300 "origin/$MAIN" 2>/dev/null)"
  keep=""
  echo " Commits on this branch that are not on origin/$MAIN:" >&2
  for c in $(git rev-list --reverse "origin/$MAIN..$localsha" 2>/dev/null); do
    short="$(git rev-parse --short "$c")"
    subj="$(git log -1 --format=%s "$c")"
    if printf '%s\n' "$main_subjects" | grep -Fxq "$subj"; then
      echo "   DROP  $short  $subj" >&2
      echo "         ^ same subject already landed on main (squash-merged)" >&2
    else
      echo "   KEEP  $short  $subj" >&2
      keep="$keep $short"
    fi
  done
  echo "" >&2

  if [ -z "$keep" ]; then
    echo " Nothing on this branch is new. It is already fully merged — delete it:" >&2
    echo "   git checkout main && git fetch origin main && git reset --hard origin/main" >&2
    echo "   git branch -D $branch" >&2
    echo "" >&2
    continue
  fi

  echo " Repair — rebuild the branch on origin/$MAIN, keeping only your work:" >&2
  echo "" >&2
  echo "   git fetch origin $MAIN" >&2
  echo "   git checkout -B $branch --no-track origin/$MAIN" >&2
  echo "   git cherry-pick$keep" >&2
  echo "" >&2
  echo " Re-run all three gates (the tree changed, so the old pass is stale):" >&2
  echo "   node --check game.js && node economy.test.mjs && node pacing.mjs" >&2
  echo "" >&2
  echo " Then push:" >&2
  echo "   git push --force-with-lease origin $branch" >&2
  echo "" >&2
  echo " Verify exactly your commits are ahead of main:" >&2
  echo "   git log --oneline origin/$MAIN..HEAD" >&2
  echo "" >&2
  echo " Next time, start branches with:" >&2
  echo "   ${REPO_ROOT:-.}/.githooks/new-branch.sh <name>" >&2
  echo "" >&2
done

exit $rc
